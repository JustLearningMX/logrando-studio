---
import { url } from "../../lib/url.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Shelf from "../../components/Shelf.astro";

// Lo publicado, del más reciente al más viejo: shorts y videos largos. Enlaces
// tomados de cada publish_status.json del archivo (C:\OpenMontage-Content\devtip\<id>\).
// Un video largo no lleva `tiktok` (sólo sale completo en YouTube) y sí `meta`.
const videos: { title: string; tag: string; youtube: string; tiktok?: string; meta?: string }[] = [
  { title: "¿Por qué JavaScript te deja cambiar algo que declaraste con const?", tag: "JavaScript · básico",
    youtube: "https://youtu.be/1NU0pLeX9Js", tiktok: "https://www.tiktok.com/@deviatips/video/7691201858232159509" },
  { title: "¿Por qué Python te devuelve None al ordenar tu lista?", tag: "Python · básico",
    youtube: "https://youtu.be/tE3mfkrem4Y", tiktok: "https://www.tiktok.com/@deviatips/video/7691201666284113158" },
  { title: "¿Por qué tu consulta SQL trae productos que no pediste?", tag: "SQL · medio",
    youtube: "https://youtu.be/i9y2Km3Nyx0", tiktok: "https://www.tiktok.com/@deviatips/video/7691201504551652628" },
  { title: "Patrones de diseño desde cero: primero aprende este idioma (POO y UML)",
    tag: "Video largo · Patrones de diseño 01", youtube: "https://youtu.be/4dYG_cseLxA",
    meta: "Clases, objetos, UML y qué es un patrón · 3 capítulos · 14 min" },
  { title: "¿Por qué JavaScript dice que 17 + 1 es 171?", tag: "JavaScript · básico",
    youtube: "https://youtu.be/lnAaGQbmn5k", tiktok: "https://www.tiktok.com/@deviatips/video/7690656469296909588" },
  { title: "¿Por qué SQL cuenta 2 clientes si tienes 3?", tag: "SQL · medio",
    youtube: "https://youtu.be/vjU9hOLw5B4", tiktok: "https://www.tiktok.com/@deviatips/video/7690656298089647381" },
  { title: "¿Por qué Python redondea 2.5 a 2 y no a 3?", tag: "Python · básico",
    youtube: "https://youtu.be/Z9v8k6dT9Q8", tiktok: "https://www.tiktok.com/@deviatips/video/7690656111409794324" },
  { title: "¿Por qué Python te da cero la segunda vez que sumas?", tag: "Python · medio",
    youtube: "https://youtu.be/RvcDD9VM8HI", tiktok: "https://www.tiktok.com/@deviatips/video/7690044694239169813" },
  { title: "¿Cómo entró a tu sistema sin saber la contraseña?", tag: "SQL · medio",
    youtube: "https://youtu.be/42WrRt1ZXIc", tiktok: "https://www.tiktok.com/@deviatips/video/7690044904977730836" },
  { title: "¿Por qué JavaScript te agenda la cita un mes después?", tag: "JavaScript · básico",
    youtube: "https://youtu.be/0nYgxyFefCY", tiktok: "https://www.tiktok.com/@deviatips/video/7690045090747698453" },
  { title: "¿Por qué JavaScript convierte tu 7 en NaN con esta línea tan común?", tag: "JavaScript · medio",
    youtube: "https://youtu.be/BWKLML_Mg88", tiktok: "https://www.tiktok.com/@deviatips/video/7689656175775763732" },
  { title: "¿Por qué SQL dice que 7 entre 10 es cero?", tag: "SQL · básico",
    youtube: "https://youtu.be/7dCEysLqJkc", tiktok: "https://www.tiktok.com/@deviatips/video/7689655909110254869" },
  { title: "¿Por qué Python se salta un número cuando limpias tu lista?", tag: "Python · básico",
    youtube: "https://youtu.be/KU2Gy-ZRCcU", tiktok: "https://www.tiktok.com/@deviatips/video/7689655658832006452" },
  { title: "¿Por qué este ciclo de JavaScript cuenta 3, 3, 3 en vez de 0, 1, 2?", tag: "JavaScript · medio-avanzado",
    youtube: "https://youtu.be/_jDZIO73XWM", tiktok: "https://www.tiktok.com/@deviatips/video/7689127871826234645" },
  { title: "¿Por qué Python cambia tres casillas si solo tocaste una?", tag: "Python · básico",
    youtube: "https://youtu.be/7alw1ky86x8", tiktok: "https://www.tiktok.com/@deviatips/video/7689127589218241813" },
  { title: "¿Por qué esta consulta SQL se queda vacía por un solo dato faltante?", tag: "SQL · medio-avanzado",
    youtube: "https://youtu.be/NHMIp0UCpjs", tiktok: "https://www.tiktok.com/@deviatips/video/7688415720417332501" },
  { title: "¿Por qué JavaScript pone el 10 antes del 2 al ordenar tus números?", tag: "JavaScript · básico",
    youtube: "https://youtu.be/XFdE10oPn2E", tiktok: "https://www.tiktok.com/@deviatips/video/7688116645918772500" },
  { title: "¿Por qué esta función de Python recuerda lo que le pasaste antes?", tag: "Python · medio",
    youtube: "https://youtu.be/uR2ZlB85abs", tiktok: "https://www.tiktok.com/@deviatips/video/7688405228957338900" },
  { title: "¿Por qué tu consulta SQL regresa vacía si los datos sí existen?", tag: "SQL · medio",
    youtube: "https://youtu.be/kfjCKktF4ho", tiktok: "https://www.tiktok.com/@deviatips/video/7688404146805837077" },
  { title: "¿Por qué JavaScript no encuentra un dato que sí está en tu lista?", tag: "JavaScript · medio",
    youtube: "https://youtu.be/nS0r-3ma7Qk", tiktok: "https://www.tiktok.com/@deviatips/video/7688403249963175189" },
  { title: "¿Por qué JavaScript dice que 0.1 + 0.2 no es 0.3?", tag: "JavaScript · básico",
    youtube: "https://youtu.be/CpXlO3Befmo", tiktok: "https://www.tiktok.com/@deviatips/video/7688403641983667476" },
];
---

<BaseLayout
  title="deviatips — Logrando Studio"
  description="deviatips: tips de programación en 60 segundos. Un bug o una trampa del lenguaje por video, con código real que sí se ejecutó."
>
  <div class="wrap">

    <section class="hero" style="padding-bottom:16px">
      <p class="muted" style="margin:0 0 8px"><a href={url("/#canales")}>← Canales</a></p>
      <h1><span style="font-family:var(--mono);color:var(--primary)">[/]</span> deviatips</h1>
      <p class="lede">
        Tips de programación, en 60 segundos. Un bug o una trampa del lenguaje
        por video — de esos que no lanzan error, simplemente te devuelven algo
        que no esperabas.
      </p>
      <ul class="pill-row" style="margin-top:20px">
        <li class="pill">Español · México</li>
        <li class="pill">Shorts 9:16</li>
        <li class="pill">Videos largos 16:9</li>
      </ul>

      <p style="margin-top:24px">
        <a class="btn" href="https://www.youtube.com/@deviatips" rel="noopener">Ver en YouTube</a>
        <a class="btn secondary" href="https://www.tiktok.com/@deviatips" rel="noopener">Ver en TikTok</a>
      </p>
    </section>

    <section class="section" style="padding-top:24px">
      <h2>Qué vas a encontrar</h2>
      <div class="grid" style="margin-top:20px">
        <div class="card">
          <h3>Código que sí corrió</h3>
          <p class="muted">
            Cada snippet que aparece en pantalla se ejecuta antes de grabarse. Si
            el video dice que devuelve cero filas, es porque devolvió cero filas.
          </p>
        </div>
        <div class="card">
          <h3>Un solo concepto</h3>
          <p class="muted">
            Un video, una idea: por qué pasa, cómo se ve cuando te muerde en
            producción, y cuál es el arreglo. Sin relleno.
          </p>
        </div>
        <div class="card">
          <h3>Por niveles</h3>
          <p class="muted">
            De básico a medio-avanzado. El título nunca asume que ya sabes el
            término técnico — la idea es que entiendas por qué deberías
            importarte.
          </p>
        </div>
      </div>

      <h2>Temas que ya salieron</h2>
      <ul class="pill-row">
        <li class="pill">JavaScript</li>
        <li class="pill">Python</li>
        <li class="pill">SQL</li>
        <li class="pill">Patrones de diseño</li>
      </ul>
      <p class="muted" style="margin-top:16px">
        Comparaciones que mienten, ordenamientos que no ordenan, consultas que se
        vacían por un dato faltante, funciones que recuerdan lo que les pasaste
        la vez anterior, listas cuyas filas cambian todas juntas, ciclos que
        al final sólo recuerdan su último valor, conversiones que devuelven
        NaN, divisiones que pierden los decimales y filtros que se saltan
        elementos.
      </p>

      <h2>Ya salió</h2>
      <Shelf label="Videos publicados de deviatips">
        {videos.map((v) => (
          <div class="card">
            <span class="tag">{v.tag}</span>
            <h3>{v.title}</h3>
            {v.meta && <p class="muted">{v.meta}</p>}
            <p style="margin-bottom:0">
              <a href={v.youtube} rel="noopener">YouTube</a>
              {v.tiktok && <span class="muted"> · </span>}
              {v.tiktok && <a href={v.tiktok} rel="noopener">TikTok</a>}
            </p>
          </div>
        ))}
      </Shelf>

      <h2>Cómo se produce</h2>
      <p>
        deviatips se produce con el sistema del estudio: guion, verificación del
        código, narración, subtítulos sincronizados palabra por palabra,
        miniatura y render. Antes de publicarse, cada video pasa por revisiones
        independientes de exactitud técnica y de coherencia, y por una revisión
        final de una persona. Los detalles del proceso están en
        <a href={url("/#como-funciona")}>cómo funciona</a>.
      </p>
    </section>

  </div>
</BaseLayout>
